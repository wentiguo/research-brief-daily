# Copy to .env (git-ignored) and fill in. Real credentials never enter the repo.
#
# Sending account: 163 Mail
#   SMTP_SERVER  -> SMTP_HOST=smtp.163.com
#   SMTP_PORT    -> 465 (SSL). Do NOT use STARTTLS on 163.
#   Password     -> 163 "SMTP 服务" 客户端授权密码, NOT your login password.
#   Enable at    -> 邮箱设置 -> POP3/SMTP/IMAP -> 开启 "SMTP服务"
#
# Recipient defaults to the same address, but SMTP_TO_EMAIL overrides it.

SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_STARTTLS=false
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your_sixteen_char_authorization_code
SMTP_FROM_EMAIL=you@example.com
SMTP_TO_EMAIL=you@example.com
SMTP_RETRIES=3

# Optional SendGrid alternative (unused when SMTP_* above are set)
# SENDGRID_API_KEY=
# RESEARCH_BRIEF_FROM_EMAIL=
# RESEARCH_BRIEF_TO_EMAIL=

# Optional downstream sync
# ZOTERO_API_KEY=
# ZOTERO_USER_ID=
