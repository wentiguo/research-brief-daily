# Copy to .env (git-ignored) and fill in. Real credentials never enter the repo.
#
# Any SMTP provider works. Pick yours and set these four values:
#   SMTP_HOST     e.g. smtp.gmail.com / smtp.163.com / smtp.qq.com / smtp.office365.com
#   SMTP_PORT     465 with SMTP_USE_SSL=true, or 587 with SMTP_STARTTLS=true
#   SMTP_USERNAME your mailbox address
#   SMTP_PASSWORD an app-specific / authorization password, never your login password
#
# Some providers (for example 163 Mail) issue a separate "SMTP 服务" authorization
# code from the mailbox settings and do not accept STARTTLS; use port 465 with SSL.
#
# Recipient defaults to the same address, but SMTP_TO_EMAIL overrides it.

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_STARTTLS=false
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_EMAIL=you@example.com
SMTP_TO_EMAIL=you@example.com
SMTP_RETRIES=3

# Optional SendGrid alternative (unused when SMTP_* above are set)
# SENDGRID_API_KEY=
# RESEARCH_BRIEF_FROM_EMAIL=
# RESEARCH_BRIEF_TO_EMAIL=

# Optional downstream sync
# ZOTERO_API_KEY=
# ZOTERO_USER_ID=
